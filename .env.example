# Set ONE of these to enable the LLM classifier + generated customer messages.
# With none set, Decline Doctor runs a fully deterministic diagnosis (still works).

# Gemini — free tier, easiest to get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM — free tier, OpenAI-compatible: https://build.nvidia.com
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
